{
  "id": "formeln",
  "course": "chemie",
  "title": "Formelsammlung Chemie",
  "groups": [
    {
      "title": "Stoffmenge und Konzentration",
      "formulas": [
        {"id": "stoffmenge", "name": "Stoffmenge aus der Masse", "tex": "n = \\frac{m}{M}", "vars": [["n", "Stoffmenge", "mol"], ["m", "Masse", "g"], ["M", "molare Masse", "g/mol"]], "lessons": ["che-atombau", "che-ph"], "abi": "merken", "solve": {"m": "m = n \\cdot M", "M": "M = \\frac{m}{n}"}, "wrong": ["n = m \\cdot M"]},
        {"id": "konzentration", "name": "Stoffmengenkonzentration", "tex": "c = \\frac{n}{V}", "vars": [["c", "Konzentration", "mol/L"], ["n", "Stoffmenge", "mol"], ["V", "Volumen der Lösung", "L"]], "lessons": ["che-ph", "che-gleichgewicht"], "abi": "merken", "solve": {"n": "n = c \\cdot V", "V": "V = \\frac{n}{c}"}, "wrong": ["c = n \\cdot V"]},
        {"id": "massenkonzentration", "name": "Massenkonzentration", "tex": "\\beta = \\frac{m}{V}", "vars": [["\\beta", "Massenkonzentration", "g/L"]], "abi": "blatt", "solve": {"m": "m = \\beta \\cdot V"}, "note": "Umrechnen: $c = \\frac{\\beta}{M}$."},
        {"id": "molvolumen", "name": "Stoffmenge eines Gases", "tex": "n = \\frac{V}{V_m}", "vars": [["V_m", "molares Volumen", "L/mol"]], "abi": "blatt", "solve": {"V": "V = n \\cdot V_m"}, "wrong": ["n = V \\cdot V_m"], "note": "$V_m \\approx 22{,}4$ L/mol bei 0 °C und 24,0 L/mol bei 20 °C, jeweils bei Normaldruck."},
        {"id": "verduennung", "name": "Verdünnen", "tex": "c_1 \\cdot V_1 = c_2 \\cdot V_2", "vars": [["c_1, V_1", "Konzentration und Volumen vorher", ""], ["c_2, V_2", "nachher", ""]], "lessons": ["che-ph"], "abi": "merken", "solve": {"c_2": "c_2 = \\frac{c_1 V_1}{V_2}", "V_2": "V_2 = \\frac{c_1 V_1}{c_2}"}, "wrong": ["c_1 \\cdot V_2 = c_2 \\cdot V_1"], "note": "Die Stoffmenge des gelösten Stoffs bleibt gleich, nur das Volumen wächst."},
        {"id": "massenanteil", "name": "Massenanteil", "tex": "w = \\frac{m_i}{m_{ges}}", "vars": [["w", "Massenanteil", ""], ["m_i", "Masse des Bestandteils", "g"]], "abi": "blatt"},
        {"id": "teilchenzahl", "name": "Teilchenzahl", "tex": "N = n \\cdot N_A", "vars": [["N", "Teilchenzahl", ""], ["N_A", "Avogadro-Konstante", "1/mol"]], "lessons": ["che-atombau"], "abi": "merken", "solve": {"n": "n = \\frac{N}{N_A}"}, "wrong": ["N = \\frac{n}{N_A}"], "note": "$N_A \\approx 6{,}022 \\cdot 10^{23}$ pro Mol."},
        {"id": "ideales-gas", "name": "Zustandsgleichung idealer Gase", "tex": "p \\cdot V = n \\cdot R \\cdot T", "vars": [["p", "Druck", "Pa"], ["R", "Gaskonstante", "J/(mol·K)"], ["T", "Temperatur", "K"]], "abi": "blatt", "solve": {"n": "n = \\frac{p V}{R T}", "T": "T = \\frac{p V}{n R}"}, "wrong": ["p \\cdot V = \\frac{n R}{T}"]},
        {"id": "ausbeute", "name": "Ausbeute", "tex": "\\eta = \\frac{n_{real}}{n_{theo}}", "vars": [["\\eta", "Ausbeute", ""], ["n_{real}", "erhaltene Stoffmenge", "mol"], ["n_{theo}", "nach der Gleichung mögliche Stoffmenge", "mol"]], "abi": "merken"}
      ]
    },
    {
      "title": "Säuren und Basen",
      "formulas": [
        {"id": "ph", "name": "pH-Wert", "tex": "\\mathrm{pH} = -\\lg c(\\mathrm{H_3O^+})", "vars": [["c(\\mathrm{H_3O^+})", "Oxoniumionen-Konzentration", "mol/L"]], "lessons": ["che-ph"], "abi": "merken", "solve": {"c(\\mathrm{H_3O^+})": "c(\\mathrm{H_3O^+}) = 10^{-\\mathrm{pH}}"}, "wrong": ["\\mathrm{pH} = \\lg c(\\mathrm{H_3O^+})", "\\mathrm{pH} = -\\ln c(\\mathrm{H_3O^+})"]},
        {"id": "poh", "name": "pOH-Wert", "tex": "\\mathrm{pOH} = -\\lg c(\\mathrm{OH^-})", "lessons": ["che-ph"], "abi": "merken", "solve": {"c(\\mathrm{OH^-})": "c(\\mathrm{OH^-}) = 10^{-\\mathrm{pOH}}"}},
        {"id": "ph-poh", "name": "pH und pOH", "tex": "\\mathrm{pH} + \\mathrm{pOH} = 14", "lessons": ["che-ph"], "abi": "merken", "wrong": ["\\mathrm{pH} \\cdot \\mathrm{pOH} = 14"], "note": "Bei 25 °C; folgt aus dem Ionenprodukt des Wassers."},
        {"id": "ionenprodukt", "name": "Ionenprodukt des Wassers", "tex": "K_W = c(\\mathrm{H_3O^+}) \\cdot c(\\mathrm{OH^-})", "vars": [["K_W", "Ionenprodukt", "mol²/L²"]], "lessons": ["che-ph"], "abi": "merken", "note": "Bei 25 °C ist $K_W = 10^{-14}$ mol²/L²."},
        {"id": "ks", "name": "Säurekonstante", "tex": "K_S = \\frac{c(\\mathrm{H_3O^+}) \\cdot c(\\mathrm{A^-})}{c(\\mathrm{HA})}", "vars": [["K_S", "Säurekonstante", "mol/L"]], "lessons": ["che-ph"], "abi": "blatt", "wrong": ["K_S = \\frac{c(\\mathrm{HA})}{c(\\mathrm{H_3O^+}) \\cdot c(\\mathrm{A^-})}"], "note": "Das Wasser steht nicht im Bruch, seine Konzentration ist praktisch konstant."},
        {"id": "pks", "name": "pKS-Wert", "tex": "\\mathrm{p}K_S = -\\lg K_S", "lessons": ["che-ph"], "abi": "merken", "solve": {"K_S": "K_S = 10^{-\\mathrm{p}K_S}"}, "note": "Je kleiner der pKS-Wert, desto stärker die Säure."},
        {"id": "pks-pkb", "name": "Korrespondierendes Säure-Base-Paar", "tex": "\\mathrm{p}K_S + \\mathrm{p}K_B = 14", "lessons": ["che-ph"], "abi": "merken", "wrong": ["\\mathrm{p}K_S - \\mathrm{p}K_B = 14"]},
        {"id": "ph-stark", "name": "pH einer starken Säure", "tex": "\\mathrm{pH} = -\\lg c_0(\\mathrm{HA})", "vars": [["c_0(\\mathrm{HA})", "Ausgangskonzentration der Säure", "mol/L"]], "lessons": ["che-ph"], "abi": "merken", "note": "Starke Säuren protolysieren vollständig: jedes Säuremolekül liefert ein Oxoniumion."},
        {"id": "ph-schwach", "name": "pH einer schwachen Säure", "tex": "\\mathrm{pH} = \\tfrac{1}{2}\\left(\\mathrm{p}K_S - \\lg c_0(\\mathrm{HA})\\right)", "lessons": ["che-ph"], "abi": "blatt", "wrong": ["\\mathrm{pH} = \\mathrm{p}K_S - \\lg c_0(\\mathrm{HA})", "\\mathrm{pH} = \\tfrac{1}{2}\\left(\\mathrm{p}K_S + \\lg c_0(\\mathrm{HA})\\right)"], "note": "Näherung für geringe Protolyse, etwa für pKS über 4."},
        {"id": "henderson", "name": "Henderson-Hasselbalch-Gleichung", "tex": "\\mathrm{pH} = \\mathrm{p}K_S + \\lg\\frac{c(\\mathrm{A^-})}{c(\\mathrm{HA})}", "lessons": ["che-ph"], "abi": "blatt", "wrong": ["\\mathrm{pH} = \\mathrm{p}K_S + \\lg\\frac{c(\\mathrm{HA})}{c(\\mathrm{A^-})}", "\\mathrm{pH} = \\mathrm{p}K_S - \\lg\\frac{c(\\mathrm{A^-})}{c(\\mathrm{HA})}"], "note": "Puffer: gleich viel Säure und Base heißt $\\mathrm{pH} = \\mathrm{p}K_S$."},
        {"id": "titration", "name": "Äquivalenzpunkt einer Titration", "tex": "c_S \\cdot V_S = c_B \\cdot V_B", "vars": [["c_S, V_S", "Konzentration und Volumen der Säure", ""], ["c_B, V_B", "der Maßlösung (Base)", ""]], "lessons": ["che-ph"], "abi": "merken", "solve": {"c_S": "c_S = \\frac{c_B V_B}{V_S}"}, "wrong": ["c_S \\cdot V_B = c_B \\cdot V_S"], "note": "Für einprotonige Säuren; bei zweiprotonigen zählt jedes Proton."},
        {"id": "halbaequivalenz", "name": "Halbäquivalenzpunkt", "tex": "\\mathrm{pH} = \\mathrm{p}K_S", "lessons": ["che-ph"], "abi": "merken", "note": "Bei halbem Verbrauch bis zum Äquivalenzpunkt sind Säure und korrespondierende Base gleich konzentriert."}
      ]
    },
    {
      "title": "Gleichgewicht und Kinetik",
      "formulas": [
        {"id": "mwg", "name": "Massenwirkungsgesetz", "tex": "K_c = \\frac{c^c(\\mathrm{C}) \\cdot c^d(\\mathrm{D})}{c^a(\\mathrm{A}) \\cdot c^b(\\mathrm{B})}", "vars": [["a, b, c, d", "Koeffizienten der Reaktionsgleichung", ""]], "lessons": ["che-gleichgewicht"], "abi": "merken", "wrong": ["K_c = \\frac{c^a(\\mathrm{A}) \\cdot c^b(\\mathrm{B})}{c^c(\\mathrm{C}) \\cdot c^d(\\mathrm{D})}", "K_c = \\frac{c \\cdot c(\\mathrm{C}) \\cdot d \\cdot c(\\mathrm{D})}{a \\cdot c(\\mathrm{A}) \\cdot b \\cdot c(\\mathrm{B})}"], "note": "Produkte oben, Edukte unten, Koeffizienten als Exponenten. $K_c$ hängt nur von der Temperatur ab."},
        {"id": "geschwindigkeit", "name": "Mittlere Reaktionsgeschwindigkeit", "tex": "\\bar{v} = \\frac{\\Delta c}{\\Delta t}", "vars": [["\\bar{v}", "mittlere Geschwindigkeit", "mol/(L·s)"]], "abi": "merken", "note": "Für einen Edukt mit Minuszeichen, damit die Geschwindigkeit positiv bleibt."},
        {"id": "geschwindigkeitsgesetz", "name": "Geschwindigkeitsgesetz", "tex": "v = k \\cdot c(\\mathrm{A}) \\cdot c(\\mathrm{B})", "vars": [["k", "Geschwindigkeitskonstante", ""]], "lessons": ["che-gleichgewicht"], "abi": "blatt", "note": "Im Gleichgewicht sind Hin- und Rückreaktion gleich schnell: $K_c = \\frac{k_{hin}}{k_{rück}}$."},
        {"id": "arrhenius", "name": "Arrhenius-Gleichung", "tex": "k = A \\cdot e^{-\\frac{E_A}{R T}}", "vars": [["E_A", "Aktivierungsenergie", "J/mol"], ["A", "Stoßfaktor", ""]], "abi": "blatt", "wrong": ["k = A \\cdot e^{\\frac{E_A}{R T}}"], "note": "Faustregel (RGT): 10 K mehr verdoppeln bis vervierfachen die Geschwindigkeit."},
        {"id": "loeslichkeitsprodukt", "name": "Löslichkeitsprodukt", "tex": "K_L = c(\\mathrm{A^+}) \\cdot c(\\mathrm{B^-})", "vars": [["K_L", "Löslichkeitsprodukt eines Salzes AB", "mol²/L²"]], "lessons": ["che-gleichgewicht"], "abi": "blatt", "note": "Der Feststoff steht nicht in der Gleichung."}
      ]
    },
    {
      "title": "Energetik",
      "formulas": [
        {"id": "hess", "name": "Reaktionsenthalpie aus Bildungsenthalpien", "tex": "\\Delta_r H = \\sum \\Delta_f H(\\text{Produkte}) - \\sum \\Delta_f H(\\text{Edukte})", "abi": "merken", "wrong": ["\\Delta_r H = \\sum \\Delta_f H(\\text{Edukte}) - \\sum \\Delta_f H(\\text{Produkte})"], "note": "Elemente in ihrer stabilen Form haben die Bildungsenthalpie null."},
        {"id": "gibbs", "name": "Gibbs-Helmholtz-Gleichung", "tex": "\\Delta G = \\Delta H - T \\cdot \\Delta S", "vars": [["\\Delta G", "freie Enthalpie", "kJ/mol"], ["\\Delta S", "Entropieänderung", "kJ/(mol·K)"], ["T", "Temperatur", "K"]], "lessons": ["che-gleichgewicht"], "abi": "blatt", "solve": {"T": "T = \\frac{\\Delta H - \\Delta G}{\\Delta S}"}, "wrong": ["\\Delta G = \\Delta H + T \\cdot \\Delta S", "\\Delta G = T \\cdot \\Delta H - \\Delta S"], "note": "$\\Delta G < 0$: die Reaktion läuft freiwillig ab. Einheiten angleichen, J und kJ nicht mischen."},
        {"id": "entropie", "name": "Reaktionsentropie", "tex": "\\Delta_r S = \\sum S(\\text{Produkte}) - \\sum S(\\text{Edukte})", "abi": "merken"},
        {"id": "kalorimetrie", "name": "Wärme im Kalorimeter", "tex": "Q = c_W \\cdot m \\cdot \\Delta T", "vars": [["c_W", "spezifische Wärmekapazität von Wasser", "J/(g·K)"], ["m", "Masse des Wassers", "g"], ["\\Delta T", "Temperaturänderung", "K"]], "abi": "merken", "solve": {"\\Delta T": "\\Delta T = \\frac{Q}{c_W m}", "m": "m = \\frac{Q}{c_W \\Delta T}"}, "wrong": ["Q = \\frac{c_W \\cdot m}{\\Delta T}"], "note": "$c_W \\approx 4{,}19$ J/(g·K)."},
        {"id": "molare-enthalpie", "name": "Molare Reaktionsenthalpie aus dem Versuch", "tex": "\\Delta_r H = -\\frac{Q}{n}", "abi": "merken", "wrong": ["\\Delta_r H = \\frac{Q}{n}"], "note": "Erwärmt sich das Wasser, gibt die Reaktion Wärme ab: das Vorzeichen wird negativ."},
        {"id": "gibbs-k", "name": "Freie Enthalpie und Gleichgewichtskonstante", "tex": "\\Delta G^0 = -R \\cdot T \\cdot \\ln K", "abi": "blatt", "solve": {"K": "K = e^{-\\frac{\\Delta G^0}{R T}}"}, "wrong": ["\\Delta G^0 = R \\cdot T \\cdot \\ln K"]}
      ]
    },
    {
      "title": "Elektrochemie",
      "formulas": [
        {"id": "zellspannung", "name": "Zellspannung", "tex": "\\Delta E = E(\\text{Akzeptor}) - E(\\text{Donator})", "vars": [["E", "Elektrodenpotential", "V"]], "abi": "merken", "wrong": ["\\Delta E = E(\\text{Donator}) - E(\\text{Akzeptor})"], "note": "Akzeptor: die Halbzelle, in der reduziert wird (Kathode, Pluspol der galvanischen Zelle)."},
        {"id": "nernst", "name": "Nernst-Gleichung", "tex": "E = E^0 + \\frac{0{,}059\\,\\mathrm{V}}{z} \\cdot \\lg\\frac{c(\\mathrm{Ox})}{c(\\mathrm{Red})}", "vars": [["E^0", "Standardpotential", "V"], ["z", "übertragene Elektronen", ""]], "abi": "blatt", "wrong": ["E = E^0 + \\frac{0{,}059\\,\\mathrm{V}}{z} \\cdot \\lg\\frac{c(\\mathrm{Red})}{c(\\mathrm{Ox})}", "E = E^0 - \\frac{0{,}059\\,\\mathrm{V}}{z} \\cdot \\lg\\frac{c(\\mathrm{Ox})}{c(\\mathrm{Red})}"], "note": "Bei 25 °C. Für ein Metall in seiner Salzlösung steht im Bruch nur $c(\\mathrm{M^{z+}})$."},
        {"id": "konzentrationszelle", "name": "Spannung einer Konzentrationszelle", "tex": "\\Delta E = \\frac{0{,}059\\,\\mathrm{V}}{z} \\cdot \\lg\\frac{c_1}{c_2}", "vars": [["c_1", "größere Konzentration", "mol/L"], ["c_2", "kleinere Konzentration", "mol/L"]], "abi": "blatt", "wrong": ["\\Delta E = 0{,}059\\,\\mathrm{V} \\cdot z \\cdot \\lg\\frac{c_1}{c_2}"]},
        {"id": "wasserstoffelektrode", "name": "Potential der Wasserstoffelektrode", "tex": "E = -0{,}059\\,\\mathrm{V} \\cdot \\mathrm{pH}", "abi": "blatt", "note": "Bei 25 °C und 1 bar Wasserstoff; Grundlage der pH-Messung mit Elektroden."},
        {"id": "faraday", "name": "Faradaysches Gesetz", "tex": "n = \\frac{I \\cdot t}{z \\cdot F}", "vars": [["I", "Stromstärke", "A"], ["t", "Zeit", "s"], ["z", "Elektronen pro Teilchen", ""], ["F", "Faraday-Konstante", "C/mol"]], "abi": "blatt", "solve": {"t": "t = \\frac{n z F}{I}", "I": "I = \\frac{n z F}{t}"}, "wrong": ["n = \\frac{I \\cdot t \\cdot z}{F}", "n = \\frac{z \\cdot F}{I \\cdot t}"], "note": "$F \\approx 96\\,485$ C/mol: die Ladung von einem Mol Elektronen."},
        {"id": "faraday-masse", "name": "Abgeschiedene Masse", "tex": "m = \\frac{M \\cdot I \\cdot t}{z \\cdot F}", "abi": "blatt", "solve": {"t": "t = \\frac{m z F}{M I}"}, "wrong": ["m = \\frac{I \\cdot t}{M \\cdot z \\cdot F}"]},
        {"id": "gibbs-zelle", "name": "Freie Enthalpie einer galvanischen Zelle", "tex": "\\Delta G = -z \\cdot F \\cdot \\Delta E", "abi": "blatt", "solve": {"\\Delta E": "\\Delta E = -\\frac{\\Delta G}{z F}"}, "wrong": ["\\Delta G = z \\cdot F \\cdot \\Delta E"], "note": "Positive Zellspannung heißt negative freie Enthalpie: die Zelle liefert freiwillig Strom."}
      ]
    },
    {
      "title": "Analytik und Atombau",
      "formulas": [
        {"id": "massenzahl", "name": "Massenzahl", "tex": "A = Z + N", "vars": [["A", "Massenzahl", ""], ["Z", "Protonenzahl", ""], ["N", "Neutronenzahl", ""]], "lessons": ["che-atombau"], "abi": "merken", "solve": {"N": "N = A - Z"}, "wrong": ["A = Z \\cdot N"]},
        {"id": "lambert-beer", "name": "Lambert-Beersches Gesetz", "tex": "E = \\varepsilon \\cdot c \\cdot d", "vars": [["E", "Extinktion", ""], ["\\varepsilon", "molarer Extinktionskoeffizient", "L/(mol·cm)"], ["d", "Schichtdicke", "cm"]], "abi": "blatt", "solve": {"c": "c = \\frac{E}{\\varepsilon d}"}, "wrong": ["E = \\frac{\\varepsilon \\cdot c}{d}"]},
        {"id": "extinktion", "name": "Extinktion", "tex": "E = \\lg\\frac{I_0}{I}", "vars": [["I_0", "eingestrahlte Intensität", ""], ["I", "durchgelassene Intensität", ""]], "abi": "blatt", "wrong": ["E = \\lg\\frac{I}{I_0}"]},
        {"id": "photon-chemie", "name": "Energie absorbierten Lichts", "tex": "E = h \\cdot \\frac{c}{\\lambda}", "vars": [["\\lambda", "Wellenlänge", "m"]], "lessons": ["che-atombau"], "abi": "merken", "solve": {"\\lambda": "\\lambda = \\frac{h c}{E}"}, "wrong": ["E = h \\cdot \\frac{\\lambda}{c}"], "note": "Kürzere Wellenlänge, größere Energie: so erklärt sich die Farbe konjugierter Systeme."},
        {"id": "rf-wert", "name": "Rf-Wert der Chromatografie", "tex": "R_f = \\frac{s_{Substanz}}{s_{Laufmittel}}", "vars": [["s_{Substanz}", "Laufstrecke des Flecks", "cm"], ["s_{Laufmittel}", "Laufstrecke der Front", "cm"]], "abi": "merken", "wrong": ["R_f = \\frac{s_{Laufmittel}}{s_{Substanz}}"], "note": "Liegt immer zwischen 0 und 1."},
        {"id": "dbe", "name": "Doppelbindungsäquivalent", "tex": "\\mathrm{DBE} = \\frac{2C + 2 + N - H - X}{2}", "vars": [["C, N, H, X", "Anzahl C-, N-, H- und Halogenatome", ""]], "abi": "merken", "wrong": ["\\mathrm{DBE} = \\frac{2C + 2 - N - H - X}{2}"], "note": "Zählt Ringe und Mehrfachbindungen zusammen: Benzol $\\mathrm{C_6H_6}$ hat 4, Glucose $\\mathrm{C_6H_{12}O_6}$ hat 1."},
        {"id": "drehwinkel", "name": "Drehwinkel optisch aktiver Lösungen", "tex": "\\alpha = [\\alpha] \\cdot \\beta \\cdot l", "vars": [["[\\alpha]", "spezifischer Drehwinkel", "°·mL/(g·dm)"], ["\\beta", "Massenkonzentration", "g/mL"], ["l", "Länge der Küvette", "dm"]], "abi": "blatt", "solve": {"\\beta": "\\beta = \\frac{\\alpha}{[\\alpha] \\cdot l}"}, "note": "Mutarotation der Glucose: frische α-Glucose dreht mit +112°, die Lösung pendelt sich bei +52,7° ein."}
      ]
    }
  ]
}
