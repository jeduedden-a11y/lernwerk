      "id": "film",
      "type": "anim",
      "md": "Bei $\\tfrac00$ entscheidet das Verhältnis der Geschwindigkeiten, mit denen Zähler und Nenner verschwinden. Das ist die Idee hinter L'Hospital.",
      "widget": "derivation",
      "params": {
        "start": 0,
        "lines": [
          {
            "tex": "\\lim_{x \\to 0}\\frac{1 - \\cos x}{x^2}",
            "why": "Form $\\tfrac00$."
          },
          {
            "tex": "= \\lim_{x \\to 0}\\frac{\\sin x}{2x}",
            "why": "L'Hospital: Zähler und Nenner getrennt ableiten. Wieder $\\tfrac00$."
          },
          {
            "tex": "= \\lim_{x \\to 0}\\frac{\\cos x}{2} = \\frac12",
            "why": "Noch einmal: Jetzt ist der Grenzwert klar."
          },
          {
            "tex": "1 - \\cos x = \\tfrac{x^2}{2} - \\tfrac{x^4}{24} + \\dots",
            "why": "Gegenprobe mit der Reihe: $\\tfrac{1 - \\cos x}{x^2} = \\tfrac12 - \\tfrac{x^2}{24} + \\dots \\to \\tfrac12$."
          },
          {
            "tex": "\\frac{f(x)}{g(x)} = \\frac{f(x) - f(0)}{g(x) - g(0)} = \\frac{f'(\\xi)}{g'(\\xi)}",
            "why": "Warum es klappt: verallgemeinerter Mittelwertsatz von Cauchy."
          }
        ]
      },
      "int": [
        "k"
      ],
      "timeline": [
