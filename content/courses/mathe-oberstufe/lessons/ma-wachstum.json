  "steps": [
    {
      "type": "text",
      "md": "Wächst ein Bestand pro Zeitschritt um denselben **Faktor**, ist das Wachstum exponentiell: $N(t) = N_0 \\cdot a^t = N_0 \\cdot e^{kt}$ mit $k = \\ln a$. Die **Verdopplungszeit** ist $T_2 = \\frac{\\ln 2}{k}$, bei Zerfall ($k < 0$) die **Halbwertszeit** $T_{1/2} = \\frac{\\ln 2}{|k|}$.",
      "id": "t1"
    },
    {
      "type": "choice",
      "md": "Ein Bestand wächst jedes Jahr um 5 %. Welcher Term beschreibt ihn?",
      "options": [
        {
          "md": "$N(t) = N_0 \\cdot 1{,}05^t$",
          "correct": true
        },
        {
          "md": "$N(t) = N_0 + 0{,}05t$",
          "why": "Das wäre lineares Wachstum um einen festen Betrag."
        },
        {
          "md": "$N(t) = N_0 \\cdot 0{,}05^t$",
          "why": "Der Faktor ist 1 plus Wachstumsrate."
        },
        {
          "md": "$N(t) = N_0 \\cdot 5^t$",
          "why": "Das wäre ein Wachstum um 400 % pro Jahr."
        }
      ],
      "explain": "Prozentuales Wachstum heißt: Multiplizieren mit $1 + p$. Bei 5 % ist der Faktor 1,05.",
      "id": "c1"
    },
    {
