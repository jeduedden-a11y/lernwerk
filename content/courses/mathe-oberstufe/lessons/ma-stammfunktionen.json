  "steps": [
    {
      "type": "text",
      "md": "| $f(x)$ | Stammfunktion $F(x)$ |\n|---|---|\n| $e^{kx}$ | $\\frac1k e^{kx}$ |\n| $a^x$ | $\\frac{a^x}{\\ln a}$ |\n| $\\ln x$ | $x\\ln x - x$ |\n| $\\sin(kx)$ | $-\\frac1k\\cos(kx)$ |\n| $\\cos(kx)$ | $\\frac1k\\sin(kx)$ |\n| $\\frac{1}{x}$ | $\\ln|x|$ |\n\nDie Stammfunktion von $\\ln x$ findet man mit partieller Integration ($\\ln x = 1 \\cdot \\ln x$).",
      "id": "t1"
    },
    {
      "type": "choice",
      "md": "Welche Stammfunktion hat $f(x) = 3e^{-2x}$?",
      "options": [
        {
          "md": "$-\\frac32 e^{-2x}$",
          "correct": true
        },
        {
          "md": "$3e^{-2x}$"
        },
        {
          "md": "$-6e^{-2x}$"
        },
        {
          "md": "$\\frac32 e^{-2x}$"
        }
      ],
      "explain": "$\\int 3e^{-2x}dx = 3 \\cdot \\frac{1}{-2}e^{-2x}$. Probe: $\\left(-\\frac32 e^{-2x}\\right)' = 3e^{-2x}$.",
      "id": "c1"
    },
    {
      "type": "numeric",
      "label": "Rechnen",
      "md": "Berechne $\\int_1^e \\ln x\\,dx$.",
      "answer": 1,
      "tolerance": 0.001,
      "placeholder": "",
      "explain": "$[x\\ln x - x]_1^e = (e - e) - (0 - 1) = 1$.",
      "id": "n1"
    },
    {
      "type": "gen",
      "gen": "ma-rechnen",
      "level": 1,
      "params": {
        "typ": "partiell"
      },
      "label": "Partielle Integration",
      "id": "g1"
    },
    {
      "type": "summary",
      "md": "Das Wichtigste:",
      "points": [
        "∫ e^{kx} dx = e^{kx}/k; ∫ ln x dx = x ln x − x.",
        "∫ sin(kx) = −cos(kx)/k, ∫ cos(kx) = sin(kx)/k.",
        "Immer durch Ableiten prüfen."
      ],
      "id": "summary"
    }
  ]
}
