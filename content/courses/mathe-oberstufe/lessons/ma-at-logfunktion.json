  "steps": [
    {
      "type": "text",
      "md": "**So erkennst du den Typ:** Eine Funktion mit $\\ln$ ist gegeben; Definitionsbereich, Nullstellen, Ableitung und Verhalten am Rand sind gefragt.",
      "label": "Aufgabentyp",
      "id": "t1"
    },
    {
      "type": "order",
      "label": "Lösungsweg",
      "md": "Bringe die Schritte des Lösungswegs in die richtige Reihenfolge.",
      "items": [
        "Definitionsbereich: Argument > 0",
        "Nullstelle: Argument = 1",
        "Ableitung: $(\\ln u)' = \\frac{u'}{u}$",
        "Randverhalten: $\\ln x \\to -\\infty$ für $x \\to 0^+$, wächst langsamer als jede Potenz"
      ],
      "explain": "Die Reihenfolge: 1. Definitionsbereich: Argument > 0. 2. Nullstelle: Argument = 1. 3. Ableitung: $(\\ln u)' = \\frac{u'}{u}$. 4. Randverhalten: $\\ln x \\to -\\infty$ für $x \\to 0^+$, wächst langsamer als jede Potenz.",
      "id": "o1"
    },
    {
      "type": "choice",
      "md": "Wo hat $f(x) = \\ln(2x - 4)$ ihre Nullstelle?",
      "options": [
        {
          "md": "bei $x = 2{,}5$",
          "correct": true
        },
        {
          "md": "bei $x = 2$",
          "why": "Dort ist $f$ gar nicht definiert."
        },
        {
          "md": "bei $x = 0$",
          "why": "$\\ln(-4)$ existiert nicht."
        }
      ],
      "explain": "$\\ln u = 0 \\iff u = 1$: $2x - 4 = 1$, $x = 2{,}5$.",
      "label": "Typischer Fehler",
      "id": "c1"
    },
    {
      "type": "gen",
      "gen": "ma-rechnen",
      "level": 2,
      "params": {
        "typ": [
          "umkehr",
          "logarithmus"
        ]
      },
      "label": "Umkehrfunktion",
      "id": "g1"
    },
