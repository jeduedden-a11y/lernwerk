{
  "id": "formeln",
  "course": "physik",
  "title": "Formelsammlung Physik",
  "groups": [
    {
      "title": "Bewegungen",
      "formulas": [
        { "id": "gleichfoermig", "name": "Gleichförmige Bewegung", "tex": "s = v \\cdot t", "vars": [["s", "Weg", "m"], ["v", "Geschwindigkeit", "m/s"], ["t", "Zeit", "s"]], "lessons": ["phy-kinematik"], "abi": "merken", "solve": { "v": "v = \\frac{s}{t}", "t": "t = \\frac{s}{v}" }, "wrong": ["s = \\frac{v}{t}"] },
        { "id": "beschl-v", "name": "Geschwindigkeit bei konstanter Beschleunigung", "tex": "v = a \\cdot t + v_0", "vars": [["v", "Geschwindigkeit", "m/s"], ["a", "Beschleunigung", "m/s²"], ["t", "Zeit", "s"], ["v_0", "Anfangsgeschwindigkeit", "m/s"]], "lessons": ["phy-kinematik"], "abi": "merken", "solve": { "a": "a = \\frac{v - v_0}{t}", "t": "t = \\frac{v - v_0}{a}" }, "wrong": ["v = \\tfrac{1}{2} a t^2 + v_0"] },
        { "id": "beschl-s", "name": "Weg bei konstanter Beschleunigung", "tex": "s = \\tfrac{1}{2} a t^2 + v_0 t + s_0", "vars": [["s", "Ort", "m"], ["a", "Beschleunigung", "m/s²"], ["v_0", "Anfangsgeschwindigkeit", "m/s"], ["s_0", "Anfangsort", "m"]], "lessons": ["phy-kinematik"], "abi": "blatt", "wrong": ["s = a t^2 + v_0 t + s_0", "s = \\tfrac{1}{2} a t + v_0 t + s_0"], "note": "Aus der Ruhe und vom Ursprung aus bleibt $s = \\tfrac{1}{2} a t^2$." },
        { "id": "aus-ruhe", "name": "Weg aus der Ruhe", "tex": "s = \\tfrac{1}{2} a t^2", "vars": [["s", "Weg", "m"], ["a", "Beschleunigung", "m/s²"], ["t", "Zeit", "s"]], "lessons": ["phy-kinematik"], "abi": "merken", "solve": { "a": "a = \\frac{2s}{t^2}", "t": "t = \\sqrt{\\frac{2s}{a}}" }, "wrong": ["s = a t^2"] },
        { "id": "zeitfrei", "name": "Zeitfreie Gleichung", "tex": "v^2 = v_0^2 + 2 a s", "vars": [["v", "Endgeschwindigkeit", "m/s"], ["v_0", "Anfangsgeschwindigkeit", "m/s"], ["a", "Beschleunigung", "m/s²"], ["s", "Weg", "m"]], "lessons": ["phy-kinematik"], "abi": "blatt", "solve": { "s": "s = \\frac{v^2 - v_0^2}{2a}", "a": "a = \\frac{v^2 - v_0^2}{2s}" }, "wrong": ["v^2 = v_0^2 + a s"], "note": "Bremsweg: mit $v = 0$ wird $s = \\frac{v_0^2}{2a}$, doppelte Geschwindigkeit heißt vierfacher Bremsweg." },
        { "id": "freier-fall", "name": "Freier Fall", "tex": "h = \\tfrac{1}{2} g t^2", "vars": [["h", "Fallhöhe", "m"], ["g", "Fallbeschleunigung", "m/s²"], ["t", "Fallzeit", "s"]], "lessons": ["phy-kinematik"], "abi": "merken", "solve": { "t": "t = \\sqrt{\\frac{2h}{g}}", "g": "g = \\frac{2h}{t^2}" }, "wrong": ["h = g t^2", "h = \\tfrac{1}{2} g t"] },
        { "id": "waagerechter-wurf", "name": "Bahn beim waagerechten Wurf", "tex": "y = -\\frac{g}{2 v_0^2} x^2", "vars": [["y", "Höhe relativ zum Abwurf", "m"], ["x", "waagerechte Strecke", "m"], ["v_0", "Abwurfgeschwindigkeit", "m/s"]], "abi": "blatt", "wrong": ["y = -\\frac{g}{2 v_0} x^2", "y = -\\frac{2 v_0^2}{g} x^2"], "note": "Waagerecht gleichförmig, senkrecht freier Fall: $x = v_0 t$ in $y = -\\tfrac{1}{2} g t^2$ einsetzen." }
      ]
    },
    {
      "title": "Kraft, Energie, Impuls",
      "formulas": [
        { "id": "newton2", "name": "Grundgleichung der Mechanik", "tex": "F = m \\cdot a", "vars": [["F", "Kraft", "N"], ["m", "Masse", "kg"], ["a", "Beschleunigung", "m/s²"]], "lessons": ["phy-energie"], "abi": "merken", "solve": { "m": "m = \\frac{F}{a}", "a": "a = \\frac{F}{m}" }, "wrong": ["F = \\frac{m}{a}"] },
        { "id": "gewichtskraft", "name": "Gewichtskraft", "tex": "F_G = m \\cdot g", "vars": [["F_G", "Gewichtskraft", "N"], ["m", "Masse", "kg"], ["g", "Fallbeschleunigung", "m/s²"]], "abi": "merken", "solve": { "m": "m = \\frac{F_G}{g}" } },
        { "id": "reibung", "name": "Reibungskraft", "tex": "F_R = \\mu \\cdot F_N", "vars": [["F_R", "Reibungskraft", "N"], ["\\mu", "Reibungszahl", ""], ["F_N", "Normalkraft", "N"]], "abi": "blatt", "solve": { "\\mu": "\\mu = \\frac{F_R}{F_N}", "F_N": "F_N = \\frac{F_R}{\\mu}" }, "wrong": ["F_R = \\frac{\\mu}{F_N}"] },
        { "id": "hooke", "name": "Hookesches Gesetz", "tex": "F = D \\cdot s", "vars": [["F", "Federkraft", "N"], ["D", "Federkonstante", "N/m"], ["s", "Auslenkung", "m"]], "lessons": ["phy-energie", "phy-schwingung"], "abi": "merken", "solve": { "D": "D = \\frac{F}{s}", "s": "s = \\frac{F}{D}" }, "wrong": ["F = \\frac{D}{s}"] },
        { "id": "epot", "name": "Lageenergie", "tex": "E_{pot} = m g h", "vars": [["E_{pot}", "Lageenergie", "J"], ["m", "Masse", "kg"], ["h", "Höhe", "m"]], "lessons": ["phy-energie"], "abi": "merken", "solve": { "h": "h = \\frac{E_{pot}}{m g}", "m": "m = \\frac{E_{pot}}{g h}" } },
        { "id": "ekin", "name": "Bewegungsenergie", "tex": "E_{kin} = \\tfrac{1}{2} m v^2", "vars": [["E_{kin}", "Bewegungsenergie", "J"], ["m", "Masse", "kg"], ["v", "Geschwindigkeit", "m/s"]], "lessons": ["phy-energie"], "abi": "merken", "solve": { "v": "v = \\sqrt{\\frac{2 E_{kin}}{m}}", "m": "m = \\frac{2 E_{kin}}{v^2}" }, "wrong": ["E_{kin} = m v^2", "E_{kin} = \\tfrac{1}{2} m v"] },
        { "id": "espann", "name": "Spannenergie einer Feder", "tex": "E_{Sp} = \\tfrac{1}{2} D s^2", "vars": [["E_{Sp}", "Spannenergie", "J"], ["D", "Federkonstante", "N/m"], ["s", "Auslenkung", "m"]], "lessons": ["phy-energie", "phy-schwingung"], "abi": "blatt", "solve": { "s": "s = \\sqrt{\\frac{2 E_{Sp}}{D}}", "D": "D = \\frac{2 E_{Sp}}{s^2}" }, "wrong": ["E_{Sp} = D s^2", "E_{Sp} = \\tfrac{1}{2} D s"] },
        { "id": "arbeit", "name": "Arbeit", "tex": "W = F \\cdot s", "vars": [["W", "Arbeit", "J"], ["F", "Kraft längs des Weges", "N"], ["s", "Weg", "m"]], "lessons": ["phy-energie"], "abi": "merken", "solve": { "F": "F = \\frac{W}{s}", "s": "s = \\frac{W}{F}" } },
        { "id": "leistung", "name": "Leistung", "tex": "P = \\frac{W}{t}", "vars": [["P", "Leistung", "W"], ["W", "Arbeit", "J"], ["t", "Zeit", "s"]], "abi": "merken", "solve": { "W": "W = P \\cdot t", "t": "t = \\frac{W}{P}" }, "wrong": ["P = W \\cdot t"] },
        { "id": "impuls", "name": "Impuls", "tex": "p = m \\cdot v", "vars": [["p", "Impuls", "kg·m/s"], ["m", "Masse", "kg"], ["v", "Geschwindigkeit", "m/s"]], "lessons": ["phy-energie"], "abi": "merken", "solve": { "v": "v = \\frac{p}{m}", "m": "m = \\frac{p}{v}" } },
        { "id": "impulserhaltung", "name": "Impulserhaltung beim Stoß", "tex": "m_1 v_1 + m_2 v_2 = m_1 v_1' + m_2 v_2'", "vars": [["v_1, v_2", "Geschwindigkeiten vorher", "m/s"], ["v_1', v_2'", "Geschwindigkeiten nachher", "m/s"]], "lessons": ["phy-energie"], "abi": "merken", "wrong": ["m_1 v_1^2 + m_2 v_2^2 = m_1 v_1' + m_2 v_2'"], "note": "Gilt bei jedem Stoß; Energieerhaltung der Bewegungsenergie nur beim elastischen." },
        { "id": "unelastisch", "name": "Gemeinsame Geschwindigkeit nach unelastischem Stoß", "tex": "v' = \\frac{m_1 v_1 + m_2 v_2}{m_1 + m_2}", "vars": [["v'", "gemeinsame Geschwindigkeit", "m/s"]], "lessons": ["phy-energie"], "abi": "blatt", "wrong": ["v' = \\frac{m_1 v_1 + m_2 v_2}{m_1 m_2}", "v' = \\frac{v_1 + v_2}{2}"] },
        { "id": "kraftstoss", "name": "Kraftstoß", "tex": "F \\cdot \\Delta t = \\Delta p", "vars": [["F", "mittlere Kraft", "N"], ["\\Delta t", "Dauer", "s"], ["\\Delta p", "Impulsänderung", "kg·m/s"]], "abi": "blatt", "solve": { "F": "F = \\frac{\\Delta p}{\\Delta t}", "\\Delta t": "\\Delta t = \\frac{\\Delta p}{F}" } }
      ]
    },
    {
      "title": "Kreisbewegung und Gravitation",
      "formulas": [
        { "id": "winkelgeschwindigkeit", "name": "Winkelgeschwindigkeit", "tex": "\\omega = \\frac{2\\pi}{T}", "vars": [["\\omega", "Winkelgeschwindigkeit", "1/s"], ["T", "Umlaufdauer", "s"]], "lessons": ["phy-schwingung"], "abi": "merken", "solve": { "T": "T = \\frac{2\\pi}{\\omega}" }, "wrong": ["\\omega = 2\\pi T"] },
        { "id": "bahngeschwindigkeit", "name": "Bahngeschwindigkeit", "tex": "v = \\omega \\cdot r", "vars": [["v", "Bahngeschwindigkeit", "m/s"], ["r", "Radius", "m"]], "abi": "merken", "solve": { "\\omega": "\\omega = \\frac{v}{r}", "r": "r = \\frac{v}{\\omega}" } },
        { "id": "zentripetal", "name": "Zentripetalkraft", "tex": "F_Z = \\frac{m v^2}{r}", "vars": [["F_Z", "Zentripetalkraft", "N"], ["m", "Masse", "kg"], ["v", "Bahngeschwindigkeit", "m/s"], ["r", "Radius", "m"]], "abi": "blatt", "solve": { "v": "v = \\sqrt{\\frac{F_Z r}{m}}", "r": "r = \\frac{m v^2}{F_Z}" }, "wrong": ["F_Z = \\frac{m v}{r}", "F_Z = m v^2 r"], "note": "Mit $v = \\omega r$ auch $F_Z = m \\omega^2 r$." },
        { "id": "gravitation", "name": "Gravitationsgesetz", "tex": "F_G = G \\cdot \\frac{m_1 m_2}{r^2}", "vars": [["G", "Gravitationskonstante", "m³/(kg·s²)"], ["r", "Abstand der Schwerpunkte", "m"]], "abi": "blatt", "wrong": ["F_G = G \\cdot \\frac{m_1 m_2}{r}", "F_G = G \\cdot \\frac{m_1 + m_2}{r^2}"], "note": "Für eine Kreisbahn: $G \\frac{m M}{r^2} = \\frac{m v^2}{r}$, die Masse des Trabanten kürzt sich." },
        { "id": "kepler3", "name": "Drittes Keplersches Gesetz", "tex": "\\frac{T_1^2}{T_2^2} = \\frac{a_1^3}{a_2^3}", "vars": [["T", "Umlaufdauer", "s"], ["a", "große Halbachse", "m"]], "abi": "blatt", "wrong": ["\\frac{T_1^3}{T_2^3} = \\frac{a_1^2}{a_2^2}", "\\frac{T_1}{T_2} = \\frac{a_1}{a_2}"] }
      ]
    },
    {
      "title": "Elektrisches Feld und Stromkreis",
      "formulas": [
        { "id": "ohm", "name": "Widerstand", "tex": "R = \\frac{U}{I}", "vars": [["R", "Widerstand", "Ω"], ["U", "Spannung", "V"], ["I", "Stromstärke", "A"]], "abi": "merken", "solve": { "U": "U = R \\cdot I", "I": "I = \\frac{U}{R}" }, "wrong": ["R = U \\cdot I"] },
        { "id": "stromstaerke", "name": "Stromstärke", "tex": "I = \\frac{Q}{t}", "vars": [["Q", "Ladung", "C"], ["t", "Zeit", "s"]], "abi": "merken", "solve": { "Q": "Q = I \\cdot t", "t": "t = \\frac{Q}{I}" } },
        { "id": "el-leistung", "name": "Elektrische Leistung", "tex": "P = U \\cdot I", "vars": [["P", "Leistung", "W"]], "abi": "merken", "solve": { "I": "I = \\frac{P}{U}", "U": "U = \\frac{P}{I}" } },
        { "id": "feldstaerke", "name": "Elektrische Feldstärke", "tex": "E = \\frac{F}{q}", "vars": [["E", "Feldstärke", "N/C = V/m"], ["F", "Kraft auf die Probeladung", "N"], ["q", "Probeladung", "C"]], "lessons": ["phy-kondensator"], "abi": "merken", "solve": { "F": "F = q \\cdot E", "q": "q = \\frac{F}{E}" }, "wrong": ["E = F \\cdot q"] },
        { "id": "plattenfeld", "name": "Feld im Plattenkondensator", "tex": "E = \\frac{U}{d}", "vars": [["U", "Spannung", "V"], ["d", "Plattenabstand", "m"]], "lessons": ["phy-kondensator"], "abi": "merken", "solve": { "U": "U = E \\cdot d", "d": "d = \\frac{U}{E}" }, "wrong": ["E = U \\cdot d"] },
        { "id": "kapazitaet", "name": "Kapazität", "tex": "C = \\frac{Q}{U}", "vars": [["C", "Kapazität", "F"], ["Q", "Ladung", "C"], ["U", "Spannung", "V"]], "lessons": ["phy-kondensator"], "abi": "merken", "solve": { "Q": "Q = C \\cdot U", "U": "U = \\frac{Q}{C}" }, "wrong": ["C = Q \\cdot U"] },
        { "id": "plattenkondensator", "name": "Kapazität des Plattenkondensators", "tex": "C = \\varepsilon_0 \\varepsilon_r \\frac{A}{d}", "vars": [["\\varepsilon_0", "elektrische Feldkonstante", "As/(Vm)"], ["\\varepsilon_r", "Permittivitätszahl", ""], ["A", "Plattenfläche", "m²"], ["d", "Plattenabstand", "m"]], "lessons": ["phy-kondensator"], "abi": "blatt", "solve": { "d": "d = \\varepsilon_0 \\varepsilon_r \\frac{A}{C}", "A": "A = \\frac{C d}{\\varepsilon_0 \\varepsilon_r}" }, "wrong": ["C = \\varepsilon_0 \\varepsilon_r \\frac{d}{A}"] },
        { "id": "energie-kondensator", "name": "Energie im Kondensator", "tex": "E_{el} = \\tfrac{1}{2} C U^2", "vars": [["E_{el}", "Feldenergie", "J"]], "lessons": ["phy-kondensator"], "abi": "blatt", "solve": { "U": "U = \\sqrt{\\frac{2 E_{el}}{C}}", "C": "C = \\frac{2 E_{el}}{U^2}" }, "wrong": ["E_{el} = C U^2", "E_{el} = \\tfrac{1}{2} C U"] },
        { "id": "coulomb", "name": "Coulombsches Gesetz", "tex": "F = \\frac{1}{4\\pi\\varepsilon_0} \\cdot \\frac{q_1 q_2}{r^2}", "vars": [["q_1, q_2", "Ladungen", "C"], ["r", "Abstand", "m"]], "abi": "blatt", "wrong": ["F = \\frac{1}{4\\pi\\varepsilon_0} \\cdot \\frac{q_1 q_2}{r}"] },
        { "id": "beschleunigung-u", "name": "Geschwindigkeit nach Beschleunigungsspannung", "tex": "v = \\sqrt{\\frac{2 e U_B}{m}}", "vars": [["e", "Elementarladung", "C"], ["U_B", "Beschleunigungsspannung", "V"], ["m", "Teilchenmasse", "kg"]], "lessons": ["phy-kondensator"], "abi": "merken", "solve": { "U_B": "U_B = \\frac{m v^2}{2 e}" }, "wrong": ["v = \\frac{2 e U_B}{m}", "v = \\sqrt{\\frac{e U_B}{2 m}}"], "note": "Aus $e U_B = \\tfrac{1}{2} m v^2$: die Feldarbeit wird zu Bewegungsenergie." },
        { "id": "entladung", "name": "Entladekurve des Kondensators", "tex": "Q(t) = Q_0 \\cdot e^{-\\frac{t}{R C}}", "vars": [["Q_0", "Anfangsladung", "C"], ["R C", "Zeitkonstante", "s"]], "abi": "blatt", "solve": { "t": "t = -R C \\ln\\frac{Q}{Q_0}" }, "wrong": ["Q(t) = Q_0 \\cdot e^{-R C t}"], "note": "Nach $t = RC$ sind noch rund 37 % der Ladung da, die Halbwertszeit ist $RC \\ln 2$." }
      ]
    },
    {
      "title": "Magnetfeld und Induktion",
      "formulas": [
        { "id": "lorentz", "name": "Lorentzkraft", "tex": "F_L = q \\cdot v \\cdot B", "vars": [["q", "Ladung", "C"], ["v", "Geschwindigkeit senkrecht zu B", "m/s"], ["B", "magnetische Flussdichte", "T"]], "abi": "merken", "solve": { "B": "B = \\frac{F_L}{q v}", "v": "v = \\frac{F_L}{q B}" }, "wrong": ["F_L = \\frac{q v}{B}"] },
        { "id": "leiterkraft", "name": "Kraft auf einen stromdurchflossenen Leiter", "tex": "F = I \\cdot l \\cdot B", "vars": [["I", "Stromstärke", "A"], ["l", "Leiterlänge im Feld", "m"]], "abi": "merken", "solve": { "B": "B = \\frac{F}{I l}", "I": "I = \\frac{F}{l B}" }, "note": "Mit diesem Zusammenhang wird $B$ an der Stromwaage gemessen." },
        { "id": "spule", "name": "Feld einer langen Spule", "tex": "B = \\mu_0 \\mu_r \\frac{N I}{l}", "vars": [["\\mu_0", "magnetische Feldkonstante", "Vs/(Am)"], ["N", "Windungszahl", ""], ["l", "Spulenlänge", "m"]], "abi": "blatt", "solve": { "I": "I = \\frac{B l}{\\mu_0 \\mu_r N}", "N": "N = \\frac{B l}{\\mu_0 \\mu_r I}" }, "wrong": ["B = \\mu_0 \\mu_r \\frac{N l}{I}"] },
        { "id": "kreisbahn", "name": "Radius der Kreisbahn im Magnetfeld", "tex": "r = \\frac{m v}{q B}", "vars": [["r", "Bahnradius", "m"], ["m", "Teilchenmasse", "kg"]], "abi": "merken", "solve": { "B": "B = \\frac{m v}{q r}", "v": "v = \\frac{q B r}{m}" }, "wrong": ["r = \\frac{q B}{m v}", "r = \\frac{m v^2}{q B}"], "note": "Aus Lorentzkraft gleich Zentripetalkraft: $q v B = \\frac{m v^2}{r}$." },
        { "id": "spezifische-ladung", "name": "Spezifische Ladung im Fadenstrahlrohr", "tex": "\\frac{e}{m} = \\frac{2 U_B}{B^2 r^2}", "vars": [["U_B", "Beschleunigungsspannung", "V"], ["r", "Bahnradius", "m"]], "abi": "blatt", "solve": { "U_B": "U_B = \\frac{e B^2 r^2}{2 m}" }, "wrong": ["\\frac{e}{m} = \\frac{2 U_B}{B r^2}", "\\frac{e}{m} = \\frac{B^2 r^2}{2 U_B}"], "note": "Für Elektronen etwa $1{,}76 \\cdot 10^{11}$ C/kg." },
        { "id": "wien-filter", "name": "Geschwindigkeitsfilter", "tex": "v = \\frac{E}{B}", "vars": [["E", "elektrische Feldstärke", "V/m"]], "abi": "blatt", "solve": { "E": "E = v \\cdot B", "B": "B = \\frac{E}{v}" }, "wrong": ["v = E \\cdot B"], "note": "Nur Teilchen mit genau dieser Geschwindigkeit fliegen gerade durch, unabhängig von Masse und Ladung." },
        { "id": "hall", "name": "Hallspannung", "tex": "U_H = v \\cdot B \\cdot b", "vars": [["U_H", "Hallspannung", "V"], ["b", "Breite des Leiters", "m"]], "abi": "blatt", "solve": { "B": "B = \\frac{U_H}{v b}" }, "note": "Gleichgewicht von elektrischer Kraft und Lorentzkraft: $e \\frac{U_H}{b} = e v B$." },
        { "id": "fluss", "name": "Magnetischer Fluss", "tex": "\\Phi = B \\cdot A", "vars": [["\\Phi", "magnetischer Fluss", "Wb = Vs"], ["A", "durchsetzte Fläche", "m²"]], "abi": "merken", "solve": { "B": "B = \\frac{\\Phi}{A}" } },
        { "id": "induktion", "name": "Induktionsgesetz", "tex": "U_{ind} = -N \\cdot \\dot{\\Phi}", "vars": [["N", "Windungszahl", ""], ["\\dot{\\Phi}", "zeitliche Änderung des Flusses", "Vs/s"]], "abi": "blatt", "wrong": ["U_{ind} = -N \\cdot \\Phi"], "note": "Das Minuszeichen ist die Lenzsche Regel: der Induktionsstrom wirkt seiner Ursache entgegen." },
        { "id": "leiterschaukel", "name": "Induktion am bewegten Leiter", "tex": "U_{ind} = B \\cdot l \\cdot v", "vars": [["l", "Leiterlänge im Feld", "m"], ["v", "Geschwindigkeit", "m/s"]], "abi": "blatt", "solve": { "v": "v = \\frac{U_{ind}}{B l}" } },
        { "id": "selbstinduktion", "name": "Selbstinduktion", "tex": "U_{ind} = -L \\cdot \\dot{I}", "vars": [["L", "Induktivität", "H"], ["\\dot{I}", "Änderung der Stromstärke", "A/s"]], "abi": "blatt" },
        { "id": "induktivitaet", "name": "Induktivität einer langen Spule", "tex": "L = \\mu_0 \\mu_r \\frac{N^2 A}{l}", "vars": [["A", "Querschnittsfläche", "m²"]], "abi": "blatt", "wrong": ["L = \\mu_0 \\mu_r \\frac{N A}{l}"] },
        { "id": "energie-spule", "name": "Energie im Magnetfeld einer Spule", "tex": "E_{mag} = \\tfrac{1}{2} L I^2", "vars": [["E_{mag}", "Feldenergie", "J"]], "abi": "blatt", "solve": { "I": "I = \\sqrt{\\frac{2 E_{mag}}{L}}" }, "wrong": ["E_{mag} = L I^2"] }
      ]
    },
    {
      "title": "Schwingungen und Wellen",
      "formulas": [
        { "id": "frequenz", "name": "Frequenz und Periodendauer", "tex": "f = \\frac{1}{T}", "vars": [["f", "Frequenz", "Hz"], ["T", "Periodendauer", "s"]], "lessons": ["phy-schwingung"], "abi": "merken", "solve": { "T": "T = \\frac{1}{f}" }, "wrong": ["f = T"] },
        { "id": "harmonisch", "name": "Harmonische Schwingung", "tex": "y(t) = \\hat{y} \\cdot \\sin(\\omega t)", "vars": [["\\hat{y}", "Amplitude", "m"], ["\\omega", "Kreisfrequenz", "1/s"]], "lessons": ["phy-schwingung"], "abi": "merken", "note": "Geschwindigkeit $\\dot{y} = \\hat{y} \\omega \\cos(\\omega t)$, Beschleunigung $\\ddot{y} = -\\omega^2 y$." },
        { "id": "federpendel", "name": "Federpendel", "tex": "T = 2\\pi \\sqrt{\\frac{m}{D}}", "vars": [["m", "schwingende Masse", "kg"], ["D", "Federkonstante", "N/m"]], "lessons": ["phy-schwingung"], "abi": "blatt", "solve": { "D": "D = \\frac{4\\pi^2 m}{T^2}", "m": "m = \\frac{D T^2}{4\\pi^2}" }, "wrong": ["T = 2\\pi \\sqrt{\\frac{D}{m}}", "T = 2\\pi \\frac{m}{D}"] },
        { "id": "fadenpendel", "name": "Fadenpendel (kleine Auslenkung)", "tex": "T = 2\\pi \\sqrt{\\frac{l}{g}}", "vars": [["l", "Pendellänge", "m"], ["g", "Fallbeschleunigung", "m/s²"]], "lessons": ["phy-schwingung"], "abi": "blatt", "solve": { "l": "l = \\frac{g T^2}{4\\pi^2}", "g": "g = \\frac{4\\pi^2 l}{T^2}" }, "wrong": ["T = 2\\pi \\sqrt{\\frac{g}{l}}"], "note": "Unabhängig von der Masse: doppelte Länge, $\\sqrt{2}$-fache Periode." },
        { "id": "thomson", "name": "Thomsonsche Schwingungsgleichung", "tex": "T = 2\\pi \\sqrt{L C}", "vars": [["L", "Induktivität", "H"], ["C", "Kapazität", "F"]], "abi": "blatt", "solve": { "C": "C = \\frac{T^2}{4\\pi^2 L}", "L": "L = \\frac{T^2}{4\\pi^2 C}" }, "wrong": ["T = 2\\pi \\sqrt{\\frac{L}{C}}", "T = \\frac{2\\pi}{\\sqrt{L C}}"] },
        { "id": "wellengleichung", "name": "Grundgleichung der Wellen", "tex": "c = \\lambda \\cdot f", "vars": [["c", "Ausbreitungsgeschwindigkeit", "m/s"], ["\\lambda", "Wellenlänge", "m"]], "abi": "merken", "solve": { "\\lambda": "\\lambda = \\frac{c}{f}", "f": "f = \\frac{c}{\\lambda}" }, "wrong": ["c = \\frac{\\lambda}{f}"] },
        { "id": "welle", "name": "Harmonische Welle", "tex": "y(x,t) = \\hat{y} \\sin\\left(2\\pi\\left(\\frac{t}{T} - \\frac{x}{\\lambda}\\right)\\right)", "vars": [["x", "Ort", "m"], ["t", "Zeit", "s"]], "abi": "blatt", "note": "Läuft in positive $x$-Richtung; jeder Ort schwingt mit der Verzögerung $\\frac{x}{c}$." },
        { "id": "stehende-welle", "name": "Eigenschwingung, beide Enden fest", "tex": "l = k \\cdot \\frac{\\lambda}{2}", "vars": [["l", "Länge des Trägers", "m"], ["k", "Ordnung (1, 2, 3, ...)", ""]], "abi": "merken", "solve": { "\\lambda": "\\lambda = \\frac{2l}{k}" }, "wrong": ["l = k \\cdot \\lambda"], "note": "Ein festes und ein loses Ende: $l = (2k - 1)\\frac{\\lambda}{4}$." },
        { "id": "gitter", "name": "Maxima am Gitter und Doppelspalt", "tex": "d \\cdot \\sin\\alpha_k = k \\cdot \\lambda", "vars": [["d", "Spalt- oder Gitterabstand", "m"], ["\\alpha_k", "Winkel zum k-ten Maximum", ""], ["k", "Ordnung", ""]], "abi": "blatt", "solve": { "\\lambda": "\\lambda = \\frac{d \\sin\\alpha_k}{k}", "d": "d = \\frac{k \\lambda}{\\sin\\alpha_k}" }, "wrong": ["d \\cdot \\cos\\alpha_k = k \\cdot \\lambda", "\\lambda \\cdot \\sin\\alpha_k = k \\cdot d"], "note": "Dazu $\\tan\\alpha_k = \\frac{a_k}{e}$ mit Abstand $a_k$ auf dem Schirm und Schirmabstand $e$." },
        { "id": "kleinwinkel", "name": "Kleinwinkelnäherung am Doppelspalt", "tex": "\\lambda \\approx \\frac{d \\cdot a_k}{k \\cdot e}", "vars": [["a_k", "Abstand des k-ten Maximums von der Mitte", "m"], ["e", "Abstand Spalt zu Schirm", "m"]], "abi": "blatt", "note": "Nur für kleine Winkel, etwa unter 5°; sonst über $\\tan$ und $\\sin$ rechnen." },
        { "id": "minimum", "name": "Gangunterschied bei Auslöschung", "tex": "\\Delta s = (2k + 1) \\cdot \\frac{\\lambda}{2}", "vars": [["\\Delta s", "Gangunterschied", "m"]], "abi": "merken", "wrong": ["\\Delta s = k \\cdot \\lambda"] },
        { "id": "bragg", "name": "Bragg-Bedingung", "tex": "2 d \\cdot \\sin\\vartheta = k \\cdot \\lambda", "vars": [["d", "Netzebenenabstand", "m"], ["\\vartheta", "Glanzwinkel", ""]], "abi": "blatt", "solve": { "\\lambda": "\\lambda = \\frac{2 d \\sin\\vartheta}{k}", "d": "d = \\frac{k \\lambda}{2 \\sin\\vartheta}" }, "wrong": ["d \\cdot \\sin\\vartheta = k \\cdot \\lambda"] }
      ]
    },
    {
      "title": "Quantenphysik",
      "formulas": [
        { "id": "photonenenergie", "name": "Energie eines Photons", "tex": "E = h \\cdot f", "vars": [["h", "Plancksches Wirkungsquantum", "Js"], ["f", "Frequenz", "Hz"]], "lessons": ["phy-photoeffekt"], "abi": "merken", "solve": { "f": "f = \\frac{E}{h}", "h": "h = \\frac{E}{f}" }, "wrong": ["E = \\frac{h}{f}"], "note": "Mit $c = \\lambda f$ auch $E = \\frac{h c}{\\lambda}$." },
        { "id": "photoeffekt", "name": "Einsteinsche Gleichung des Photoeffekts", "tex": "E_{kin} = h \\cdot f - W_A", "vars": [["E_{kin}", "größte Bewegungsenergie der Elektronen", "J oder eV"], ["W_A", "Austrittsarbeit", "J oder eV"]], "lessons": ["phy-photoeffekt"], "abi": "merken", "solve": { "W_A": "W_A = h f - E_{kin}", "f": "f = \\frac{E_{kin} + W_A}{h}" }, "wrong": ["E_{kin} = h \\cdot f + W_A"] },
        { "id": "gegenfeld", "name": "Gegenfeldmethode", "tex": "e \\cdot U_0 = h \\cdot f - W_A", "vars": [["U_0", "Gegenspannung, bei der der Strom null wird", "V"]], "lessons": ["phy-photoeffekt"], "abi": "blatt", "solve": { "U_0": "U_0 = \\frac{h f - W_A}{e}" }, "note": "Aufgetragen gegen $f$ ergibt $U_0$ eine Gerade mit Steigung $\\frac{h}{e}$." },
        { "id": "grenzfrequenz", "name": "Grenzfrequenz", "tex": "f_G = \\frac{W_A}{h}", "vars": [["f_G", "kleinste auslösende Frequenz", "Hz"]], "lessons": ["phy-photoeffekt"], "abi": "merken", "solve": { "W_A": "W_A = h \\cdot f_G" }, "wrong": ["f_G = W_A \\cdot h"] },
        { "id": "photonenimpuls", "name": "Impuls eines Photons", "tex": "p = \\frac{h}{\\lambda}", "vars": [["p", "Impuls", "kg·m/s"], ["\\lambda", "Wellenlänge", "m"]], "abi": "blatt", "solve": { "\\lambda": "\\lambda = \\frac{h}{p}" }, "wrong": ["p = h \\cdot \\lambda"] },
        { "id": "de-broglie", "name": "De-Broglie-Wellenlänge", "tex": "\\lambda = \\frac{h}{m \\cdot v}", "vars": [["m", "Teilchenmasse", "kg"], ["v", "Geschwindigkeit", "m/s"]], "abi": "merken", "solve": { "v": "v = \\frac{h}{m \\lambda}" }, "wrong": ["\\lambda = \\frac{m v}{h}", "\\lambda = h \\cdot m v"] },
        { "id": "de-broglie-u", "name": "De-Broglie-Wellenlänge nach Beschleunigung", "tex": "\\lambda = \\frac{h}{\\sqrt{2 m e U_B}}", "vars": [["U_B", "Beschleunigungsspannung", "V"]], "abi": "blatt", "solve": { "U_B": "U_B = \\frac{h^2}{2 m e \\lambda^2}" }, "wrong": ["\\lambda = \\frac{h}{2 m e U_B}"], "note": "Nichtrelativistisch, gut bis zu einigen Kilovolt." },
        { "id": "unschaerfe", "name": "Unbestimmtheitsrelation", "tex": "\\Delta x \\cdot \\Delta p_x \\geq \\frac{h}{4\\pi}", "vars": [["\\Delta x", "Ortsunschärfe", "m"], ["\\Delta p_x", "Impulsunschärfe", "kg·m/s"]], "abi": "blatt", "note": "In vielen Schulbüchern als Abschätzung $\\Delta x \\cdot \\Delta p_x \\geq h$ geschrieben." },
        { "id": "duane-hunt", "name": "Grenzwellenlänge der Röntgenstrahlung", "tex": "\\lambda_{min} = \\frac{h \\cdot c}{e \\cdot U_B}", "vars": [["\\lambda_{min}", "kürzeste Wellenlänge", "m"]], "abi": "blatt", "solve": { "U_B": "U_B = \\frac{h c}{e \\lambda_{min}}" }, "wrong": ["\\lambda_{min} = \\frac{e U_B}{h c}"] }
      ]
    },
    {
      "title": "Atom- und Kernphysik",
      "formulas": [
        { "id": "uebergang", "name": "Energie beim Übergang zwischen Niveaus", "tex": "h \\cdot f = E_m - E_n", "vars": [["E_m, E_n", "Energieniveaus mit m > n", "J oder eV"]], "abi": "merken", "solve": { "f": "f = \\frac{E_m - E_n}{h}" }, "wrong": ["h \\cdot f = E_m + E_n"] },
        { "id": "wasserstoff", "name": "Energieniveaus im Wasserstoffatom", "tex": "E_n = -13{,}6\\,\\mathrm{eV} \\cdot \\frac{1}{n^2}", "vars": [["n", "Hauptquantenzahl", ""]], "abi": "blatt", "wrong": ["E_n = -13{,}6\\,\\mathrm{eV} \\cdot \\frac{1}{n}"] },
        { "id": "potentialtopf", "name": "Linearer Potentialtopf", "tex": "E_n = \\frac{h^2}{8 m L^2} \\cdot n^2", "vars": [["L", "Breite des Topfes", "m"], ["n", "Quantenzahl", ""]], "abi": "blatt", "solve": { "L": "L = \\sqrt{\\frac{h^2 n^2}{8 m E_n}}" }, "wrong": ["E_n = \\frac{h^2}{8 m L^2} \\cdot n", "E_n = \\frac{h}{8 m L^2} \\cdot n^2"], "note": "In den Topf passen stehende Wellen mit $L = n \\frac{\\lambda}{2}$." },
        { "id": "zerfallsgesetz", "name": "Zerfallsgesetz", "tex": "N(t) = N_0 \\cdot e^{-\\lambda t}", "vars": [["N_0", "Anzahl der Kerne zu Beginn", ""], ["\\lambda", "Zerfallskonstante", "1/s"]], "abi": "blatt", "solve": { "t": "t = -\\frac{1}{\\lambda} \\ln\\frac{N}{N_0}" }, "wrong": ["N(t) = N_0 \\cdot e^{\\lambda t}"] },
        { "id": "halbwertszeit", "name": "Halbwertszeit", "tex": "T_{1/2} = \\frac{\\ln 2}{\\lambda}", "vars": [["T_{1/2}", "Halbwertszeit", "s"]], "abi": "merken", "solve": { "\\lambda": "\\lambda = \\frac{\\ln 2}{T_{1/2}}" }, "wrong": ["T_{1/2} = \\lambda \\cdot \\ln 2"] },
        { "id": "aktivitaet", "name": "Aktivität", "tex": "A = \\lambda \\cdot N", "vars": [["A", "Aktivität", "Bq"], ["N", "Anzahl der Kerne", ""]], "abi": "blatt", "solve": { "N": "N = \\frac{A}{\\lambda}" } },
        { "id": "masse-energie", "name": "Masse und Energie", "tex": "E = \\Delta m \\cdot c^2", "vars": [["\\Delta m", "Massendefekt", "kg oder u"], ["c", "Lichtgeschwindigkeit", "m/s"]], "abi": "merken", "solve": { "\\Delta m": "\\Delta m = \\frac{E}{c^2}" }, "wrong": ["E = \\Delta m \\cdot c"], "note": "1 u entspricht rund 931,5 MeV." }
      ]
    }
  ]
}
