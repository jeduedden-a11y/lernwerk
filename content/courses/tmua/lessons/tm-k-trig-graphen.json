    {
      "type": "text",
      "md": "$y = a\\sin(bx + c) + d$: Amplitude $|a|$, Periode $\\frac{2\\pi}{|b|}$, Verschiebung um $-\\frac{c}{b}$ in x-Richtung und um $d$ nach oben. $\\tan x$ hat die Periode $\\pi$ und Polstellen bei $\\frac{\\pi}{2} + k\\pi$.",
      "id": "t1"
    },
    {
      "type": "choice",
      "md": "What is the period of $y = 3\\sin(2x - \\pi)$?",
      "options": [
        {
          "md": "$\\pi$",
          "correct": true
        },
        {
          "md": "$\\frac{\\pi}{2}$"
        },
        {
          "md": "$2\\pi$"
        },
        {
          "md": "$3\\pi$"
        }
      ],
      "explain": "Periode $\\frac{2\\pi}{2} = \\pi$; die 3 ändert nur die Amplitude.",
      "lang": "en",
      "label": "Test question",
      "id": "c1"
    },
    {
      "type": "summary",
      "md": "Das Wichtigste:",
      "points": [
        "Amplitude |a|, Periode 2π/|b|.",
        "tan: Periode π, Polstellen.",
        "Verschiebungen wie bei allen Graphen."
      ],
      "id": "summary"
    }
  ]
