      "id": "t1"
    },
    {
      "type": "order",
      "label": "Lösungsweg",
      "md": "Bringe die Schritte des Lösungswegs in die richtige Reihenfolge.",
      "items": [
        "Integrieren, Konstante $+C$ nicht vergessen",
        "Punkt einsetzen, $C$ bestimmen",
        "Funktion vollständig angeben",
        "Gesuchten Wert berechnen"
      ],
      "explain": "Die Reihenfolge: 1. Integrieren, Konstante $+C$ nicht vergessen. 2. Punkt einsetzen, $C$ bestimmen. 3. Funktion vollständig angeben. 4. Gesuchten Wert berechnen.",
      "id": "o1"
    },
    {
      "type": "choice",
      "md": "Was passiert ohne die Konstante $C$?",
      "options": [
        {
          "md": "Die Kurve geht im Allgemeinen nicht durch den gegebenen Punkt.",
          "correct": true
        },
        {
          "md": "Nichts, $C$ ist immer 0.",
          "why": "$C$ legt fest, welche der parallel verschobenen Kurven gemeint ist."
        }
      ],
      "explain": "Der Punkt bestimmt $C$.",
      "label": "Typischer Fehler",
      "id": "c1"
