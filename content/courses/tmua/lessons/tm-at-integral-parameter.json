{
  "id": "tm-at-integral-parameter",
  "title": "Integralbedingungen mit Parameter",
  "subtitle": "Aufgabentyp",
  "vault": [
    {
      "path": "02 Wiki/TMUA/11 Integralrechnung/Aufgabentypen/Integralbedingung mit Parameter lösen.md",
      "title": "Integralbedingung mit Parameter lösen"
    }
  ],
  "steps": [
    {
      "type": "text",
      "md": "**So erkennst du den Typ:** Eine Grenze oder ein Koeffizient ist unbekannt, der Wert des Integrals gegeben.",
      "label": "Aufgabentyp",
      "id": "t1"
    },
    {
      "type": "order",
      "label": "Lösungsweg",
      "md": "Bringe die Schritte des Lösungswegs in die richtige Reihenfolge.",
      "items": [
        "Integral allgemein berechnen",
        "Gleichung mit dem Parameter aufstellen",
        "Lösen",
        "Nebenbedingungen ($a > 0$) beachten"
      ],
      "explain": "Die Reihenfolge: 1. Integral allgemein berechnen. 2. Gleichung mit dem Parameter aufstellen. 3. Lösen. 4. Nebenbedingungen ($a > 0$) beachten.",
      "id": "o1"
    },
    {
      "type": "choice",
      "md": "$a^2 - a - 6 = 0$ liefert $a = 3$ und $a = -2$. Gefordert ist $a > 0$. Was ist die Antwort?",
      "options": [
        {
          "md": "$a = 3$",
          "correct": true
        },
        {
          "md": "$a = 3$ oder $a = -2$",
          "why": "Die Bedingung schließt $-2$ aus."
        }
      ],
      "explain": "Nebenbedingungen immer zuletzt prüfen.",
      "label": "Typischer Fehler",
      "id": "c1"
    },
    {
      "type": "choice",
      "md": "Given $a > 0$ and $\\int_0^a (2x - 1)\\,dx = 6$, what is $a$?",
      "options": [
        {
          "md": "2"
        },
        {
          "md": "3",
          "correct": true
        },
        {
          "md": "4"
        },
        {
          "md": "6"
        }
      ],
      "explain": "$a^2 - a = 6$, also $a = 3$.",
      "lang": "en",
      "shuffle": false,
      "label": "Test question",
      "id": "c2"
    },
    {
      "type": "gen",
      "gen": "ma-rechnen",
      "level": 4,
      "params": {
        "typ": "integral"
      },
      "label": "Rechentraining",
      "id": "g1"
    }
  ]
}
