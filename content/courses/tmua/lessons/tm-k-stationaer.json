  "steps": [
    {
      "type": "text",
      "md": "**Stationäre Punkte**: $f'(x) = 0$. Klassifizieren mit $f''$ (negativ: Maximum, positiv: Minimum) oder mit dem Vorzeichenwechsel von $f'$. Steigend heißt $f'(x) > 0$ (TMUA: oft $\\geq 0$ für »increasing«).",
      "id": "t1"
    },
    {
      "type": "choice",
      "md": "$f(x) = x^3 - 12x$. What is the local maximum value of $f$?",
      "options": [
        {
          "md": "−16"
        },
        {
          "md": "4"
        },
        {
          "md": "8"
        },
        {
          "md": "16",
          "correct": true
        },
        {
          "md": "24"
        }
      ],
      "explain": "$f'(x) = 3x^2 - 12 = 0$ bei $x = \\pm2$; $f''(-2) < 0$, $f(-2) = -8 + 24 = 16$.",
      "lang": "en",
      "shuffle": false,
      "label": "Test question",
      "id": "c1"
    },
    {
      "type": "gen",
      "gen": "ma-rechnen",
      "level": 1,
      "params": {
        "typ": "extrem"
      },
      "label": "Rechentraining",
      "id": "g1"
    },
    {
