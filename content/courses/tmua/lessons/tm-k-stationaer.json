      "id": "g2"
    },
    {
      "type": "summary",
      "md": "Das Wichtigste:",
      "points": [
        "f'(x) = 0 notwendig.",
        "f'' oder Vorzeichenwechsel entscheidet.",
        "Monotonie aus dem Vorzeichen von f'."
      ],
      "id": "summary"
    }
  ]
