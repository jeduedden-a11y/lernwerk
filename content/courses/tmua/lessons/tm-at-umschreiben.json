  "steps": [
    {
      "type": "text",
      "md": "**So erkennst du den Typ:** Wurzeln, Brüche und Produkte, die man vor dem Ableiten als Potenzsumme schreiben kann.",
      "label": "Aufgabentyp",
      "id": "t1"
    },
    {
      "type": "order",
      "label": "Lösungsweg",
      "md": "Bringe die Schritte des Lösungswegs in die richtige Reihenfolge.",
      "items": [
        "Wurzeln als Potenzen: $\\sqrt[n]{x^m} = x^{\\frac mn}$",
        "Brüche mit einfachem Nenner aufteilen",
        "Produkte ausmultiplizieren",
        "Gliedweise ableiten"
      ],
      "explain": "Die Reihenfolge: 1. Wurzeln als Potenzen: $\\sqrt[n]{x^m} = x^{\\frac mn}$. 2. Brüche mit einfachem Nenner aufteilen. 3. Produkte ausmultiplizieren. 4. Gliedweise ableiten.",
      "id": "o1"
    },
    {
      "type": "choice",
      "md": "Was ist $\\frac{d}{dx}\\left(x\\sqrt x\\right)$?",
      "options": [
        {
          "md": "$\\frac32\\sqrt x$",
          "correct": true
        },
        {
          "md": "$\\frac{1}{2\\sqrt x}$",
          "why": "Das ist nur die Ableitung von $\\sqrt x$."
        },
        {
          "md": "$\\sqrt x$",
          "why": "$x\\sqrt x = x^{\\frac32}$, abgeleitet $\\frac32 x^{\\frac12}$."
        }
      ],
      "explain": "Umschreiben vermeidet die Produktregel.",
      "label": "Typischer Fehler",
      "id": "c1"
    },
    {
      "type": "choice",
      "md": "Differentiate $x\\sqrt x - \\frac{1}{x^2}$.",
      "options": [
        {
          "md": "$\\frac32\\sqrt x + \\frac{2}{x^3}$",
          "correct": true
        },
        {
          "md": "$\\frac32\\sqrt x - \\frac{2}{x^3}$"
        },
        {
          "md": "$\\frac{1}{2\\sqrt x} + \\frac{2}{x^3}$"
        },
        {
          "md": "$\\frac32\\sqrt x + \\frac{1}{2x}$"
        }
      ],
      "explain": "$x^{\\frac32} - x^{-2}$, abgeleitet $\\frac32 x^{\\frac12} + 2x^{-3}$.",
      "lang": "en",
      "label": "Test question",
      "id": "c2"
    }
  ]
