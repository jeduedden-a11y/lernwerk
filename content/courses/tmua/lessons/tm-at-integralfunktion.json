  "steps": [
    {
      "type": "text",
      "md": "**So erkennst du den Typ:** Ableitung einer Integralfunktion oder Integrale aus bekannten Teilintegralen.",
      "label": "Aufgabentyp",
      "id": "t1"
    },
    {
      "type": "order",
      "label": "Lösungsweg",
      "md": "Bringe die Schritte des Lösungswegs in die richtige Reihenfolge.",
      "items": [
        "Hauptsatz: $\\frac{d}{dx}\\int_a^x f(t)dt = f(x)$",
        "Bei oberer Grenze $g(x)$: Kettenregel, $f(g(x))g'(x)$",
        "Intervalle: $\\int_a^c = \\int_a^b + \\int_b^c$",
        "Umgekehrte Grenzen: Vorzeichen wechseln"
      ],
      "explain": "Die Reihenfolge: 1. Hauptsatz: $\\frac{d}{dx}\\int_a^x f(t)dt = f(x)$. 2. Bei oberer Grenze $g(x)$: Kettenregel, $f(g(x))g'(x)$. 3. Intervalle: $\\int_a^c = \\int_a^b + \\int_b^c$. 4. Umgekehrte Grenzen: Vorzeichen wechseln.",
      "id": "o1"
    },
    {
      "type": "choice",
      "md": "Was ist $\\frac{d}{dx}\\int_1^{x^2} t\\,dt$?",
      "options": [
        {
          "md": "$2x^3$",
          "correct": true
        },
        {
          "md": "$x^2$",
          "why": "Die Kettenregel liefert den Faktor $2x$."
        },
        {
          "md": "$x$",
          "why": "Die obere Grenze ist $x^2$, nicht $x$."
        }
      ],
      "explain": "$f(x^2) \\cdot 2x = x^2 \\cdot 2x$.",
      "label": "Typischer Fehler",
      "id": "c1"
    },
    {
      "type": "choice",
      "md": "$\\int_0^3 f(x)\\,dx = 4$ and $\\int_0^5 f(x)\\,dx = 9$. What is $\\int_3^5 f(x)\\,dx$?",
      "options": [
        {
          "md": "−5"
        },
        {
          "md": "4"
        },
        {
          "md": "5",
          "correct": true
        },
        {
          "md": "13"
        }
      ],
      "explain": "$\\int_0^5 = \\int_0^3 + \\int_3^5$.",
      "lang": "en",
      "shuffle": false,
      "label": "Test question",
      "id": "c2"
    },
