      "md": "Rechnen mit Arrays statt Schleifen.",
      "widget": "codetrace",
      "params": {
        "buttons": false,
        "code": "import numpy as np\na = np.array([1, 2, 3])\nprint(a * 2)\nW = np.array([[1, 0], [0, 2]])\nv = np.array([3, 4])\nprint(W @ v)",
        "trace": [
          {
            "line": 1,
            "vars": {}
          },
          {
            "line": 2,
            "vars": {
              "a": "array([1, 2, 3])"
            }
          },
